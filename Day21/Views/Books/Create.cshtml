@model BookViewModel
@{
    ViewData["Title"] = "Добавить книгу";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header"><i class="bi bi-plus-circle me-2"></i>Добавить книгу</div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <partial name="_BookForm" model="Model" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-dark">
                            <i class="bi bi-save me-1"></i>Сохранить
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary ms-auto">Отмена</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
