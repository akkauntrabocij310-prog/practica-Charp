@model IEnumerable<BookLibrary.Models.Book>
@{
    ViewData["Title"] = "Список книг";
}

<div class="page-header">
    <h1>📚 Библиотека книг</h1>
    <a asp-action="Create" class="btn btn-primary">+ Добавить книгу</a>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <p>Книг пока нет. <a asp-action="Create">Добавьте первую!</a></p>
    </div>
}
else
{
    <div class="books-grid">
        @foreach (var book in Model)
        {
            <div class="book-card">
                <div class="book-card__genre">@book.Genre</div>
                <h2 class="book-card__title">@book.Title</h2>
                <p class="book-card__author">✍️ @book.Author</p>
                <p class="book-card__year">📅 @book.Year г.</p>
                <p class="book-card__isbn">ISBN: <code>@book.ISBN</code></p>
                <a asp-action="Details" asp-route-id="@book.Id" class="btn btn-outline">
                    Подробнее →
                </a>
            </div>
        }
    </div>
}
