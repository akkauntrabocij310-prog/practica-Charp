@model Book
@{
    ViewData["Title"] = "Удалить книгу";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white">
                <i class="bi bi-exclamation-triangle me-2"></i>Подтвердите удаление
            </div>
            <div class="card-body">
                <p>Вы уверены, что хотите удалить книгу?</p>
                <dl class="row">
                    <dt class="col-sm-4">Название</dt>
                    <dd class="col-sm-8"><strong>@Model.Title</strong></dd>
                    <dt class="col-sm-4">Автор</dt>
                    <dd class="col-sm-8">@Model.Author</dd>
                    <dt class="col-sm-4">Год</dt>
                    <dd class="col-sm-8">@Model.Year</dd>
                </dl>
            </div>
            <div class="card-footer d-flex gap-2">
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i>Удалить
                    </button>
                </form>
                <a asp-action="Index" class="btn btn-outline-secondary ms-auto">Отмена</a>
            </div>
        </div>
    </div>
</div>
