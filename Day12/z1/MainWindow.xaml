<Window x:Class="StudentDiaryWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Электронный дневник студента"
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#2C3E50" 
                CornerRadius="10" Padding="20" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Электронный дневник" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="White"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Система учета успеваемости студента" 
                           FontSize="14" 
                           Foreground="#ECF0F1"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- TabControl -->
        <TabControl Grid.Row="1" FontSize="13">

            <!-- Вкладка 1: Расписание -->
            <TabItem Header="Расписание занятий">
                <DataGrid x:Name="ScheduleGrid" 
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Margin="10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Предмет" Binding="{Binding Subject}" Width="*"/>
                        <DataGridTextColumn Header="День недели" Binding="{Binding Day}" Width="120"/>
                        <DataGridTextColumn Header="Время" Binding="{Binding Time}" Width="100"/>
                        <DataGridTextColumn Header="Аудитория" Binding="{Binding Room}" Width="80"/>
                        <DataGridTextColumn Header="Преподаватель" Binding="{Binding Teacher}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Вкладка 2: Оценки -->
            <TabItem Header="Оценки">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Панель добавления -->
                    <Border Grid.Row="0" Background="White" CornerRadius="10" 
                            Padding="10" Margin="0,0,0,10" BorderBrush="#DDD" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Добавить новую оценку" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Предмет:" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
                                <ComboBox x:Name="SubjectCombo" Grid.Column="1" Margin="5" Height="30" Width="150"/>

                                <TextBlock Text="Оценка:" Grid.Column="2" VerticalAlignment="Center" Margin="5"/>
                                <ComboBox x:Name="GradeCombo" Grid.Column="3" Margin="5" Height="30" Width="80">
                                    <ComboBoxItem Content="5"/>
                                    <ComboBoxItem Content="4"/>
                                    <ComboBoxItem Content="3"/>
                                    <ComboBoxItem Content="2"/>
                                    <ComboBoxItem Content="1"/>
                                </ComboBox>

                                <TextBlock Text="Дата:" Grid.Column="4" VerticalAlignment="Center" Margin="5"/>
                                <DatePicker x:Name="GradeDatePicker" Grid.Column="5" Margin="5" Height="30" Width="120"/>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Комментарий:" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
                                <TextBox x:Name="CommentBox" Grid.Column="1" Margin="5" Height="30"/>
                                <Button x:Name="AddGradeButton" Grid.Column="2"
                                        Content="Добавить оценку" 
                                        Background="#3498DB"
                                        Foreground="White"
                                        Padding="15,8"
                                        Margin="5"
                                        Cursor="Hand"
                                        Click="AddGradeButton_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Панель фильтрации -->
                    <Border Grid.Row="1" Background="White" CornerRadius="10" 
                            Padding="10" Margin="0,0,0,10" BorderBrush="#DDD" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Фильтр:" Grid.Column="0" VerticalAlignment="Center" Margin="5" FontWeight="Bold"/>

                            <TextBlock Text="Предмет:" Grid.Column="1" VerticalAlignment="Center" Margin="5,5,0,5"/>
                            <ComboBox x:Name="FilterSubjectCombo" Grid.Column="2" 
                                      Margin="5" Height="30" Width="150"
                                      SelectionChanged="FilterSubjectCombo_SelectionChanged"/>

                            <TextBlock Text="Дата с:" Grid.Column="3" VerticalAlignment="Center" Margin="10,5,0,5"/>
                            <DatePicker x:Name="StartDatePicker" Grid.Column="4" 
                                        Margin="5" Height="30" Width="120"
                                        SelectedDateChanged="FilterDateChanged"/>

                            <TextBlock Text="по:" Grid.Column="5" VerticalAlignment="Center" Margin="5"/>
                            <DatePicker x:Name="EndDatePicker" Grid.Column="6" 
                                        Margin="5" Height="30" Width="120"
                                        SelectedDateChanged="FilterDateChanged"/>

                            <Button x:Name="ClearFilterButton" Grid.Column="7"
                                    Content="Сбросить" 
                                    Click="ClearFilterButton_Click"
                                    Background="#7F8C8D"
                                    Foreground="White"
                                    Padding="10,5"
                                    Margin="10,5,0,5"
                                    Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <!-- Таблица оценок -->
                    <DataGrid Grid.Row="2" x:Name="GradesGrid" 
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              Margin="0,5,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Предмет" Binding="{Binding Subject}" Width="150"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="100"/>
                            <DataGridTextColumn Header="Оценка" Binding="{Binding Grade}" Width="80"/>
                            <DataGridTextColumn Header="Преподаватель" Binding="{Binding Teacher}" Width="150"/>
                            <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Вкладка 3: Статистика -->
            <TabItem Header="Статистика">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Статистика -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#2C3E50" CornerRadius="10" Padding="15" Margin="5">
                            <StackPanel>
                                <TextBlock Text="Всего предметов" FontSize="12" Foreground="#ECF0F1"/>
                                <TextBlock x:Name="TotalSubjectsText" Text="0" FontSize="28" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#27AE60" CornerRadius="10" Padding="15" Margin="5">
                            <StackPanel>
                                <TextBlock Text="Всего оценок" FontSize="12" Foreground="#ECF0F1"/>
                                <TextBlock x:Name="TotalGradesText" Text="0" FontSize="28" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#F39C12" CornerRadius="10" Padding="15" Margin="5">
                            <StackPanel>
                                <TextBlock Text="Средний балл" FontSize="12" Foreground="#ECF0F1"/>
                                <TextBlock x:Name="AverageGradeText" Text="0.00" FontSize="28" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Background="#E74C3C" CornerRadius="10" Padding="15" Margin="5">
                            <StackPanel>
                                <TextBlock Text="Отличных оценок (5)" FontSize="12" Foreground="#ECF0F1"/>
                                <TextBlock x:Name="ExcellentCountText" Text="0" FontSize="28" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Таблица статистики -->
                    <DataGrid Grid.Row="1" x:Name="StatisticsGrid" 
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Предмет" Binding="{Binding Subject}" Width="200"/>
                            <DataGridTextColumn Header="Кол-во оценок" Binding="{Binding GradeCount}" Width="150"/>
                            <DataGridTextColumn Header="Средний балл" Binding="{Binding AverageGrade, StringFormat=F2}" Width="150"/>
                            <DataGridTextColumn Header="Оценки" Binding="{Binding GradesList}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>