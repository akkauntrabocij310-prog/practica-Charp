<Window x:Class="GradeBook.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GradeBook.ViewModels"
        Title="Журнал оценок"
        Width="750" Height="520"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <!-- Горячие клавиши -->
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding AddGradeCommand}"/>
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding EditGradeCommand}"/>
        <KeyBinding Key="Delete"             Command="{Binding DeleteGradeCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <!-- Стиль строки DataGrid: подсветка оценок -->
        <Style x:Key="GradeRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Value}" Value="2">
                    <Setter Property="Background" Value="#FFEEEE"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Value}" Value="1">
                    <Setter Property="Background" Value="#FFD0D0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Value}" Value="5">
                    <Setter Property="Background" Value="#EEFFEE"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ===== МЕНЮ ===== -->
        <Menu DockPanel.Dock="Top">

            <!-- Файл -->
            <MenuItem Header="_Файл">
                <MenuItem Header="_Выход"
                          Command="{Binding ExitCommand}"
                          InputGestureText="Alt+F4"/>
            </MenuItem>

            <!-- Расписание (заглушка для будущего расширения) -->
            <MenuItem Header="_Расписание">
                <MenuItem Header="Просмотр расписания" IsEnabled="False"/>
            </MenuItem>

            <!-- Оценки -->
            <MenuItem Header="_Оценки">
                <MenuItem Header="_Добавить оценку"
                          Command="{Binding AddGradeCommand}"
                          InputGestureText="Ctrl+N"/>
                <MenuItem Header="_Редактировать оценку"
                          Command="{Binding EditGradeCommand}"
                          InputGestureText="Ctrl+E"/>
                <Separator/>
                <MenuItem Header="_Удалить оценку"
                          Command="{Binding DeleteGradeCommand}"
                          InputGestureText="Del"/>
            </MenuItem>
        </Menu>

        <!-- ===== ПАНЕЛЬ ИНСТРУМЕНТОВ ===== -->
        <ToolBar DockPanel.Dock="Top" Margin="0,0,0,2">
            <Button Command="{Binding AddGradeCommand}"
                    ToolTip="Добавить оценку (Ctrl+N)"
                    Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="➕" FontSize="14" Margin="0,0,4,0"/>
                    <TextBlock Text="Добавить оценку" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Separator/>

            <Button Command="{Binding EditGradeCommand}"
                    ToolTip="Редактировать оценку (Ctrl+E)"
                    Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✏️" FontSize="14" Margin="0,0,4,0"/>
                    <TextBlock Text="Редактировать оценку" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Separator/>

            <Button Command="{Binding DeleteGradeCommand}"
                    ToolTip="Удалить оценку (Del)"
                    Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🗑️" FontSize="14" Margin="0,0,4,0"/>
                    <TextBlock Text="Удалить оценку" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </ToolBar>

        <!-- ===== СТАТУС-БАР ===== -->
        <StatusBar DockPanel.Dock="Bottom" Background="#F0F0F0">
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Всего записей: "/>
                    <Run Text="{Binding Grades.Count, Mode=OneWay}"/>
                </TextBlock>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="Ctrl+N — добавить  |  Ctrl+E — редактировать  |  Del — удалить"
                           Foreground="Gray"/>
            </StatusBarItem>
        </StatusBar>

        <!-- ===== ТАБЛИЦА ОЦЕНОК ===== -->
        <DataGrid ItemsSource="{Binding Grades}"
                  SelectedItem="{Binding SelectedGrade}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  RowStyle="{StaticResource GradeRowStyle}"
                  Margin="6,0,6,6"
                  GridLinesVisibility="Horizontal"
                  BorderBrush="#CCCCCC"
                  BorderThickness="1">

            <!-- Двойной клик → редактировать -->
            <DataGrid.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick"
                              Command="{Binding EditGradeCommand}"/>
            </DataGrid.InputBindings>

            <DataGrid.Columns>
                <DataGridTextColumn Header="#"
                                    Binding="{Binding Id}"
                                    Width="40"/>
                <DataGridTextColumn Header="Студент"
                                    Binding="{Binding StudentName}"
                                    Width="*"/>
                <DataGridTextColumn Header="Предмет"
                                    Binding="{Binding Subject}"
                                    Width="*"/>
                <DataGridTextColumn Header="Оценка"
                                    Binding="{Binding Value}"
                                    Width="70">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Дата"
                                    Binding="{Binding Date, StringFormat=dd.MM.yyyy}"
                                    Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
