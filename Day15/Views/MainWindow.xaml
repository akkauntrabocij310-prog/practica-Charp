<Window x:Class="StudentDiary.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StudentDiary.ViewModels"
        xmlns:conv="clr-namespace:StudentDiary.Converters"
        Title="Электронный дневник студента"
        Height="680" Width="1000"
        MinHeight="580" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#F0F4F8">

    <Window.DataContext>
        <vm:StudentViewModel />
    </Window.DataContext>

    <Window.Resources>
        <conv:GradeValueToColorConverter x:Key="GradeColorConverter" />
        <conv:BoolToVisibilityConverter  x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter  x:Key="InvertBoolToVis" />

        <!-- Стиль кнопок -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background"   Value="#3498DB"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Padding"      Value="14,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2980B9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#BDC3C7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#E74C3C"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C0392B"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#BDC3C7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Карточка -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#C0C0C0" BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Заголовок секции -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="14"/>
            <Setter Property="FontWeight"   Value="Bold"/>
            <Setter Property="Foreground"   Value="#2C3E50"/>
            <Setter Property="Margin"       Value="0,0,0,10"/>
        </Style>

        <!-- Поле ввода -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Padding"          Value="8,6"/>
            <Setter Property="BorderBrush"      Value="#BDC3C7"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="White" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#3498DB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Элемент ListBox -->
        <Style x:Key="ListItem" TargetType="ListBoxItem">
            <Setter Property="Padding"  Value="10,8"/>
            <Setter Property="Cursor"   Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="6" Margin="0,2"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EBF5FB"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D6EAF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Шапка -->
            <RowDefinition Height="*"/>      <!-- Основной контент -->
            <RowDefinition Height="Auto"/>   <!-- Статус-бар -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════
             ШАПКА
        ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="📚 Электронный дневник студента"
                               FontSize="22" FontWeight="Bold" Foreground="#2C3E50"/>
                    <TextBlock Text="Система учёта успеваемости · MVVM + WPF"
                               FontSize="12" Foreground="#7F8C8D" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="🔄 Обновить список"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadStudentsCommand}"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════
             ОСНОВНОЙ КОНТЕНТ
        ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="220"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── ЛЕВАЯ КОЛОНКА: список студентов ── -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="👨‍🎓 Студенты"
                               Style="{StaticResource SectionTitle}"/>

                    <!-- Индикатор загрузки -->
                    <Grid Grid.Row="1">
                        <!-- Загрузка -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="⏳" FontSize="36" HorizontalAlignment="Center"/>
                            <TextBlock Text="Загрузка…" FontSize="13" Foreground="#7F8C8D"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>

                        <!-- Список студентов -->
                        <ListBox ItemsSource="{Binding Students}"
                                 SelectedItem="{Binding SelectedStudent}"
                                 ItemContainerStyle="{StaticResource ListItem}"
                                 BorderThickness="0" Background="Transparent"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis},
                                              ConverterParameter=Invert}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Аватар-круг -->
                                        <Border Grid.Column="0" Width="36" Height="36"
                                                CornerRadius="18" Background="#3498DB"
                                                Margin="0,0,10,0">
                                            <TextBlock
                                                Text="{Binding LastName[0]}"
                                                Foreground="White" FontWeight="Bold"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FullName}"
                                                       FontWeight="SemiBold" Foreground="#2C3E50"
                                                       FontSize="13"/>
                                            <TextBlock Text="{Binding Group}"
                                                       Foreground="#7F8C8D" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <!-- ── ПРАВАЯ КОЛОНКА: оценки + форма ── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- Инфо о студенте -->
                    <RowDefinition Height="*"/>      <!-- Список оценок -->
                    <RowDefinition Height="Auto"/>   <!-- Форма добавления -->
                </Grid.RowDefinitions>

                <!-- Карточка текущего студента -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12"
                        Visibility="{Binding SelectedStudent, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding SelectedStudent.FullName}"
                                       FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock FontSize="13" Foreground="#7F8C8D" Margin="0,2,0,0">
                                <Run Text="Группа:"/>
                                <Run Text="{Binding SelectedStudent.Group}"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- Средний балл -->
                        <Border Grid.Column="1" CornerRadius="8" Padding="16,8"
                                Background="#EBF5FB" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Средний балл" FontSize="11" Foreground="#7F8C8D"
                                           HorizontalAlignment="Center"/>
                                <TextBlock FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"
                                           Text="{Binding AverageGrade, StringFormat=F1}"
                                           Foreground="#3498DB"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Подсказка: выберите студента -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12"
                        Visibility="{Binding SelectedStudent, Converter={StaticResource InvertBoolToVis},
                                     ConverterParameter=Invert}">
                    <TextBlock Text="← Выберите студента из списка"
                               Foreground="#7F8C8D" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Список оценок -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="📋 Журнал оценок" Style="{StaticResource SectionTitle}"
                                       VerticalAlignment="Center" Margin="0"/>
                            <Button Grid.Column="1"
                                    Content="🗑 Удалить"
                                    Style="{StaticResource DangerButton}"
                                    Command="{Binding RemoveGradeCommand}"
                                    FontSize="12" Padding="10,4"/>
                        </Grid>

                        <!-- Пустое состояние -->
                        <TextBlock Grid.Row="1"
                                   Text="Оценок пока нет"
                                   Foreground="#BDC3C7" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding Grades.Count,
                                       Converter={StaticResource InvertBoolToVis},
                                       ConverterParameter=Invert}"/>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Grades}"
                                 SelectedItem="{Binding SelectedGrade}"
                                 ItemContainerStyle="{StaticResource ListItem}"
                                 BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Значок оценки -->
                                        <Border Grid.Column="0"
                                                Width="40" Height="40" CornerRadius="8"
                                                Background="{Binding Value,
                                                    Converter={StaticResource GradeColorConverter}}"
                                                Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Value}"
                                                       Foreground="White" FontSize="18"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Subject}"
                                                       FontWeight="SemiBold" FontSize="13"
                                                       Foreground="#2C3E50"/>
                                            <TextBlock Text="{Binding Comment}"
                                                       Foreground="#7F8C8D" FontSize="11"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Date, StringFormat=dd.MM.yyyy}"
                                                   Foreground="#95A5A6" FontSize="11"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Форма добавления оценки -->
                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="➕ Выставить оценку" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Предмет -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Предмет" FontSize="11" Foreground="#7F8C8D"
                                           Margin="0,0,0,4"/>
                                <TextBox Text="{Binding NewSubject, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputBox}"
                                         IsEnabled="{Binding SelectedStudent,
                                             Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>

                            <!-- Оценка -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Оценка" FontSize="11" Foreground="#7F8C8D"
                                           Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding AvailableGrades}"
                                          SelectedItem="{Binding NewGradeValue}"
                                          IsEnabled="{Binding SelectedStudent,
                                              Converter={StaticResource BoolToVis}}"
                                          Padding="8,6" FontSize="13"/>
                            </StackPanel>

                            <!-- Комментарий -->
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Комментарий" FontSize="11" Foreground="#7F8C8D"
                                           Margin="0,0,0,4"/>
                                <TextBox Text="{Binding NewComment, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputBox}"
                                         IsEnabled="{Binding SelectedStudent,
                                             Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>

                            <!-- Кнопка добавить -->
                            <Button Grid.Column="6"
                                    Content="Добавить"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding AddGradeCommand}"
                                    VerticalAlignment="Bottom"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════
             СТАТУС-БАР
        ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#2C3E50" CornerRadius="6" Margin="0,12,0,0" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Индикатор загрузки в статус-баре -->
                <Ellipse Grid.Column="0" Width="10" Height="10"
                         Margin="0,0,8,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#2ECC71"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Fill" Value="#F39C12"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           Foreground="#ECF0F1" FontSize="12"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2"
                           Foreground="#95A5A6" FontSize="11" VerticalAlignment="Center">
                    <Run Text="Студентов: "/>
                    <Run Text="{Binding Students.Count}"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
