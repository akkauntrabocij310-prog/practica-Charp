<Window x:Class="StudentDiary.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StudentDiary.ViewModels"
        xmlns:conv="clr-namespace:StudentDiary.Converters"
        xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
        Title="Электронный дневник студента"
        Width="1100" Height="700"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#0F1117"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Converters -->
        <conv:GradeToColorConverter x:Key="GradeColor"/>
        <conv:AverageGradeToColorConverter x:Key="AvgGradeColor"/>

        <!-- CollectionViewSource for filtering -->
        <CollectionViewSource x:Key="GradesView" Source="{Binding Grades}"/>

        <!-- ══════════════════════════════════════════════════════
             ControlTemplate for "Обновить" (Refresh) Button
             with checkmark icon
        ══════════════════════════════════════════════════════ -->
        <ControlTemplate x:Key="RefreshButtonTemplate" TargetType="Button">
            <Border x:Name="bd" Background="#1A1D2E" BorderBrush="#2D3154"
                    BorderThickness="1" CornerRadius="8" Padding="12,8"
                    Cursor="Hand">
                <StackPanel Orientation="Horizontal">
                    <!-- Checkmark icon drawn in XAML -->
                    <Canvas Width="16" Height="16" Margin="0,0,6,0">
                        <Ellipse Canvas.Left="0" Canvas.Top="0" Width="16" Height="16"
                                 Fill="Transparent" Stroke="#6C7BFF" StrokeThickness="1.5"/>
                        <Polyline Points="4,8 7,11 12,5" Stroke="#6C7BFF"
                                  StrokeThickness="1.8" StrokeLineCap="Round"
                                  StrokeLineJoin="Round"/>
                    </Canvas>
                    <ContentPresenter VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="#252842"/>
                    <Setter TargetName="bd" Property="BorderBrush" Value="#6C7BFF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="#1A1D2E"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ══════════════════════════════════════════════════════
             DataTemplate for ListView items (StudentGrade)
        ══════════════════════════════════════════════════════ -->
        <DataTemplate x:Key="GradeRowTemplate">
            <Border Background="Transparent" Padding="4,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ID badge -->
                    <Border Grid.Column="0" Background="#1A1D2E" CornerRadius="4"
                            Width="30" Height="22" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Id}" Foreground="#6C7BFF"
                                   FontSize="11" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Student name with avatar initial -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="14" Background="#252842"
                                Margin="0,0,8,0">
                            <TextBlock Foreground="#6C7BFF" FontWeight="Bold" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Text>
                                    <Binding Path="StudentName" StringFormat="{}{0:1}"/>
                                </TextBlock.Text>
                            </TextBlock>
                        </Border>
                        <TextBlock Text="{Binding StudentName}" Foreground="#E8EAF6"
                                   FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Subject -->
                    <TextBlock Grid.Column="2" Text="{Binding Subject}" Foreground="#A0A3BD"
                               FontSize="13" VerticalAlignment="Center"/>

                    <!-- Grade with color pill -->
                    <Border Grid.Column="3" CornerRadius="6" Height="26"
                            Background="{Binding Grade, Converter={StaticResource GradeColor}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8,2">
                        <TextBlock Text="{Binding Grade, StringFormat=F1}" Foreground="White"
                                   FontWeight="Bold" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Date -->
                    <TextBlock Grid.Column="4" Text="{Binding Date}" Foreground="#5E617A"
                               FontSize="12" VerticalAlignment="Center"/>

                    <!-- Comment -->
                    <TextBlock Grid.Column="5" Text="{Binding Comment}" Foreground="#6B6E87"
                               FontSize="12" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ══════════════════════════════════════════════════════
             Style overrides
        ══════════════════════════════════════════════════════ -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#6C7BFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#5A6AEF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#252842"/>
                                <Setter Property="Foreground" Value="#3D4060"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#3D1A1A"/>
            <Setter Property="Foreground" Value="#FF6B6B"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EF4444"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#14172B"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1E2140"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FilterBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1A1D2E"/>
            <Setter Property="Foreground" Value="#E8EAF6"/>
            <Setter Property="BorderBrush" Value="#2D3154"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="#6C7BFF"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#6C7BFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- ══════════════════════════════════════════════════════════
         Keyboard shortcuts
    ══════════════════════════════════════════════════════════ -->
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding AddGradeCommand}"/>
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding EditGradeCommand}"/>
        <KeyBinding Key="Delete"             Command="{Binding DeleteGradeCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <!-- ════════════════════════════════════════════════════
             MENU BAR
        ════════════════════════════════════════════════════ -->
        <Menu DockPanel.Dock="Top" Background="#0A0C14" Foreground="#8B8FA8"
              FontSize="13" Padding="4,2">
            <Menu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="Foreground" Value="#C8CAE0"/>
                    <Setter Property="Background" Value="#0A0C14"/>
                    <Setter Property="Padding" Value="12,6"/>
                </Style>
            </Menu.Resources>

            <MenuItem Header="Файл">
                <MenuItem Header="Выход" Click="Exit_Click"/>
            </MenuItem>

            <MenuItem Header="Расписание">
                <MenuItem Header="Показать расписание" IsEnabled="False"/>
                <MenuItem Header="Импортировать расписание" IsEnabled="False"/>
            </MenuItem>

            <MenuItem Header="Оценки">
                <MenuItem Header="Добавить оценку (Ctrl+N)"
                          Command="{Binding AddGradeCommand}"/>
                <MenuItem Header="Редактировать (Ctrl+E)"
                          Command="{Binding EditGradeCommand}"/>
                <Separator/>
                <MenuItem Header="Удалить (Del)"
                          Command="{Binding DeleteGradeCommand}"/>
            </MenuItem>
        </Menu>

        <!-- ════════════════════════════════════════════════════
             MAIN CONTENT
        ════════════════════════════════════════════════════ -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── Header ──────────────────────────────────────── -->
            <Border Grid.Row="0" Background="#0A0C14" Padding="24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Электронный дневник" Foreground="#E8EAF6"
                                   FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="Управление оценками студентов"
                                   Foreground="#5E617A" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Stats row -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#1A1D2E" CornerRadius="8" Padding="14,8" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Всего оценок: " Foreground="#5E617A" FontSize="12"/>
                                <TextBlock Text="{Binding TotalGrades}" Foreground="#6C7BFF"
                                           FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1A1D2E" CornerRadius="8" Padding="14,8" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Студентов: " Foreground="#5E617A" FontSize="12"/>
                                <TextBlock Text="{Binding StudentCount}" Foreground="#A78BFA"
                                           FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <!-- OneWay average grade display -->
                        <Border Background="#1A1D2E" CornerRadius="8" Padding="14,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Средний балл: " Foreground="#5E617A" FontSize="12"/>
                                <TextBlock Text="{Binding AverageGrade, Mode=OneWay, StringFormat=F2}"
                                           Foreground="{Binding AverageGrade, Mode=OneWay, Converter={StaticResource AvgGradeColor}}"
                                           FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Toolbar ─────────────────────────────────────── -->
            <Border Grid.Row="1" Background="#0D1020" Padding="20,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Filter box -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔍" Foreground="#5E617A" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="FilterBox" Width="260"
                                 Style="{StaticResource FilterBox}"
                                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Поиск по студенту или предмету..."
                                 TextChanged="FilterBox_TextChanged"/>
                    </StackPanel>

                    <!-- Action buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <!-- Refresh button with custom ControlTemplate -->
                        <Button Content="Обновить" Margin="0,0,8,0"
                                Foreground="#A0A3BD" FontSize="12"
                                Template="{StaticResource RefreshButtonTemplate}"
                                Command="{Binding RefreshCommand}"/>

                        <Button Content="+ Добавить" Margin="0,0,8,0"
                                Style="{StaticResource ActionButton}"
                                Command="{Binding AddGradeCommand}"
                                ToolTip="Ctrl+N"/>

                        <Button Content="✎ Изменить" Margin="0,0,8,0"
                                Style="{StaticResource ActionButton}"
                                Background="#252842"
                                Command="{Binding EditGradeCommand}"
                                ToolTip="Ctrl+E"/>

                        <Button Content="✕ Удалить"
                                Style="{StaticResource DangerButton}"
                                Command="{Binding DeleteGradeCommand}"
                                ToolTip="Delete"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── List column headers ──────────────────────────── -->
            <Border Grid.Row="2" Background="#0F1117">
                <DockPanel>
                    <!-- Column header bar -->
                    <Border DockPanel.Dock="Top" Background="#0D1020" Padding="16,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="#" Foreground="#3D4060" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="СТУДЕНТ"   Foreground="#3D4060" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="ПРЕДМЕТ"   Foreground="#3D4060" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="3" Text="БАЛЛ"      Foreground="#3D4060" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="4" Text="ДАТА"      Foreground="#3D4060" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="5" Text="КОММЕНТАРИЙ" Foreground="#3D4060" FontSize="11" FontWeight="SemiBold"/>
                        </Grid>
                    </Border>

                    <!-- ListView with DataTemplate -->
                    <ListView x:Name="GradesListView"
                              ItemsSource="{Binding Grades}"
                              SelectedItem="{Binding SelectedGrade, Mode=TwoWay}"
                              ItemTemplate="{StaticResource GradeRowTemplate}"
                              ItemContainerStyle="{StaticResource ListViewItemStyle}"
                              Background="Transparent"
                              BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1E2140"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1A1D2E"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#E8EAF6"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#E8EAF6"/>
                        </ListView.Resources>
                    </ListView>
                </DockPanel>
            </Border>

            <!-- ── Status bar ──────────────────────────────────── -->
            <Border Grid.Row="3" Background="#0A0C14" Padding="20,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="#3D4060" FontSize="11">
                        <Run Text="Ctrl+N — добавить"/>
                        <Run Text="  |  " Foreground="#1E2140"/>
                        <Run Text="Ctrl+E — изменить"/>
                        <Run Text="  |  " Foreground="#1E2140"/>
                        <Run Text="Del — удалить"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
